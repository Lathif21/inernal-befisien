# Copy to .env and fill in. See docs/04-ARCHITECTURE.md → Environment variables.
# Local dev: a local Postgres database (both URLs can be the same).
# Production: Neon pooled URL + unpooled URL (for drizzle-kit migrations).
DATABASE_URL=postgres://befisien:password@localhost:5432/befisien_crm_dev
DATABASE_URL_UNPOOLED=postgres://befisien:password@localhost:5432/befisien_crm_dev
TZ=Asia/Jakarta

# Better Auth. 32+ random characters for the secret:
# node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:5173

# Production build only (`node build`, adapter-node 6): the app derives its origin from the
# Host header and assumes https. Behind Nginx, pass X-Forwarded-Proto and set:
# PROTOCOL_HEADER=x-forwarded-proto

# Daily digest (P1-12). Telegram bot from @BotFather; the webhook secret is any random string,
# also passed to setWebhook (see CLAUDE.md "Telegram + digest").
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_WEBHOOK_SECRET=
# Resend key (send-only is enough); befisien.com must be verified in Resend
RESEND_API_KEY=
MAIL_FROM="Befisien CRM <info@befisien.com>"
# Trigger.dev project ref (also in trigger.config.ts). The CLI logs in with `npx trigger.dev@latest login`.
TRIGGER_PROJECT_REF=

# AI suggestions (P2-01): Sumopod, an OpenAI-compatible gateway. AI_MODEL defaults to claude-opus-5-5.
SUMOPOD_API_KEY=
AI_MODEL=
AI_BASE_URL=
